// #region Read circuits
export circuit questionCount(pollIdHash: Field): Uint<64> {
    assert(pollIdHash != default<Field>, "Poll Id cannot be empty.");
    
    const questionCount = questionsInPoll.lookup(pollIdHash).read();
    
    return questionCount;
}

export circuit questionRead(pollIdHash: Field, questionIdHash: Field): Bytes<250> {
    assert (pollIdHash != default<Field>, "Poll Id cannot be empty");
    assert (questionIdHash != default<Field>, "Question Id cannot be empty");

    const question = questions.lookup(disclose(pollIdHash)).lookup(disclose(questionIdHash));
    return question;
}

export circuit optionRead(pollIdHash: Field, questionIdHash: Field, optionIdHash: Field): Bytes<100> {
    assert (pollIdHash != default<Field>, "Poll Id cannot be empty");
    assert (questionIdHash != default<Field>, "Question Id cannot be empty");
    assert (optionIdHash != default<Field>, "Option Id cannot be empty");

    const option = options.lookup(disclose(pollIdHash)).lookup(disclose(questionIdHash)).lookup(disclose(optionIdHash));
    return option;
}

// #endregion

// #region Helper Circuits

// Generate a hashed identity key (pseudo-random identifier)
// by hashing together two 32-byte values (typically pubkey and secret).
export pure circuit generateHashKey(tag: Bytes<32>, pK1: Bytes<32>): Field {
    return transientHash<[Bytes<32>, Bytes<32>]>([tag, pK1]);
}

export pure circuit generatePollIdHashKey(tag: Bytes<32>, pollId: Uint<64>, pK1: Bytes<32>): Field {
    return transientHash<[Bytes<32>, Uint<64>, Bytes<32>]>([tag, pollId, pK1]);
}

export pure circuit generateQuestionIdHashKey(tag: Bytes<32>, question: Bytes<250>, pollIdHash: Field): Field {
    return transientHash<[Bytes<32>, Bytes<250>, Field]>([tag, question, pollIdHash]);
}

export pure circuit generateOptionIdHashKey(tag: Bytes<32>, option: Bytes<100>, questionIdHash: Field): Field {
    return transientHash<[Bytes<32>, Bytes<100>, Field]>([tag, option, questionIdHash]);
}

// Bytes<16> fits "XXXX-XXXX" for the poll code.
export pure circuit pollKeyFromCode(tag: Bytes<32>, roomCode: Bytes<16>): Field {
    return transientHash<[Bytes<32>, Bytes<16>]>([tag, roomCode]);
}

// #endregion